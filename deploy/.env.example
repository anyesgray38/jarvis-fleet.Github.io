# Required for the fleet listener. Use a long random secret.
AEGIS_FLEET_SECRET=replace-with-a-long-random-secret

# Required for the authenticated dashboard-to-orchestrator gateway.
AEGIS_GATEWAY_TOKEN=replace-with-a-different-long-random-secret
AEGIS_GATEWAY_URL=http://127.0.0.1:8877

# Local governed worker. Keep this aligned with the host user that owns the workspace.
AEGIS_AGENT_UID=1000
AEGIS_AGENT_GID=1000
AEGIS_AGENT_NAME=Aegis Local Worker
AEGIS_AGENT_TAGS=local,research,knowledge,security,code-factory,business-prospecting,maintenance

# Required for the private inbound knowledge runtime.
AEGIS_KNOWLEDGE_TOKEN=replace-with-another-long-random-secret
AEGIS_KNOWLEDGE_URL=http://127.0.0.1:8892
AEGIS_KNOWLEDGE_INTERVAL_MINUTES=360
# Continuous department research is bounded per cycle and stored locally.
AEGIS_KNOWLEDGE_RESEARCH_ENABLED=1
AEGIS_KNOWLEDGE_MAX_JOBS_PER_CYCLE=4
AEGIS_KNOWLEDGE_MAX_SEARCH_RESULTS=3
AEGIS_KNOWLEDGE_MAX_EXTERNAL_CALLS=4
AEGIS_KNOWLEDGE_SOURCE_REFRESH_MINUTES=1440
AEGIS_KNOWLEDGE_DEPARTMENTS_CONFIG=/app/config/knowledge_departments.json
# Legacy global topics and URLs are added to Web Intelligence.
AEGIS_KNOWLEDGE_WIKI_TOPICS=
AEGIS_KNOWLEDGE_WEB_SOURCES=

# Required for the authenticated business prospecting runtime.
AEGIS_PROSPECT_TOKEN=replace-with-a-prospecting-runtime-secret
AEGIS_PROSPECT_URL=http://127.0.0.1:8893
# Optional comma-separated public directory URLs for targets whose local directory is known.
AEGIS_PROSPECT_SOURCE_URLS=
# Official Firecrawl MCP endpoint; keyless scrape/search/parse are supported with limits.
FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/v2/mcp
FIRECRAWL_API_KEY=
FIRECRAWL_OAUTH_TOKEN=
# Optional raw credential/header value. The adapter adds Bearer when needed.
FIRECRAWL_AUTHORIZATION=

# Optional direct private-interface access. Only enable this with the host firewall guard.
# AEGIS_WEB_BIND=0.0.0.0

# Optional LocalAI endpoint for model inference.
# Keep LocalAI on the same host for local-only inference, or point this at a trusted worker.
AEGIS_LOCALAI_URL=http://127.0.0.1:8080

# Optional local Ollama endpoint for inference.
AEGIS_OLLAMA_URL=http://127.0.0.1:11434

# Optional external OpenAI route. AEGIS only uses this when a request explicitly
# sets local_only=false and allow_external=true.
AEGIS_OPENAI_API_KEY=
AEGIS_OPENAI_URL=https://api.openai.com

# Compatibility alias for hosted OpenAI provider deployments.
OPENAI_API_KEY=

# Optional Shark After Dark business operations integration.
# The API stays behind the AEGIS server-side proxy; never expose the admin key to the browser.
SHARK_API_URL=https://shark-after-dark.onrender.com
SHARK_ADMIN_KEY=
