# Required for the fleet listener. Use a long random secret.
AEGIS_FLEET_SECRET=replace-with-a-long-random-secret

# Optional remote/local model endpoints reachable from the model-runtime container.
# For a host-local LM Studio/LocalAI instance, the defaults use host.docker.internal.
AEGIS_LMSTUDIO_URL=http://host.docker.internal:1234
AEGIS_LOCALAI_URL=http://host.docker.internal:8080

# Optional: enable the Cloudflare Tunnel profile for public HTTPS access.
# CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-tunnel-token
