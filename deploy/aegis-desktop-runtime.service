[Unit]
Description=AEGIS governed desktop-control runtime
After=graphical-session.target at-spi-dbus-bus.service
Wants=graphical-session.target at-spi-dbus-bus.service

[Service]
Type=simple
WorkingDirectory=%h/jarvis-fleet
ExecStart=/usr/bin/python3 %h/jarvis-fleet/desktop_runtime.py
Environment=AEGIS_DESKTOP_BIND=127.0.0.1
Environment=AEGIS_DESKTOP_PORT=8894
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
