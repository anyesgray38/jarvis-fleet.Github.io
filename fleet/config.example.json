{
  "network": {
    "provider": "tailscale",
    "allow_internet": true,
    "allow_exit_nodes": true,
    "allow_public_bind": false,
    "approved_exit_nodes": []
  },
  "enrollment": {
    "network_allowlist": ["tailscale"],
    "bootstrap_token_env": "aegis_fleet_bootstrap_token",
    "new_nodes_start_untrusted": true,
    "require_attestation_before_execution": true
  },
  "signing": {
    "algorithm": "hmac-sha256",
    "secret_env": "aegis_fleet_node_secret",
    "max_request_age_seconds": 60
  },
  "nodes": [
    {
      "node_id": "example-linux-worker",
      "address": "100.x.y.z",
      "network": "tailscale",
      "role": "worker",
      "trust": "verified",
      "status": "connected",
      "capabilities": ["core.mcp_execution", "core.model_inference"],
      "modalities": ["text"],
      "labels": ["linux", "compute"]
    }
  ]
}
