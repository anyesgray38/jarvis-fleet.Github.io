{
  "version": 2,
  "providers": [
    {
      "id": "localai",
      "kind": "model_inference",
      "status": "supported",
      "transport": "openai_compatible_http",
      "default_base_url": "http://127.0.0.1:8080",
      "modalities": [
        "text",
        "vision",
        "audio",
        "image",
        "video"
      ],
      "policy": {
        "local_preferred": true,
        "external_data_required": false
      }
    },
    {
      "id": "openai",
      "kind": "model_inference",
      "status": "supported",
      "transport": "openai_compatible_http",
      "default_base_url": "https://api.openai.com",
      "modalities": [
        "text",
        "vision"
      ],
      "policy": {
        "local_preferred": false,
        "external_data_required": false
      }
    }
  ]
}
